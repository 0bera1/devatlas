# Bu dosyayı .env.production olarak kopyalayın ve değerleri doldurun. .env.production git'e eklenmez.

# Alan adları (DNS kayıtları bu sunucuya yönlenmiş olmalı)
APP_DOMAIN=devatlas.example.com
API_DOMAIN=api.devatlas.example.com

# Web istemcisinin API adresi (derleme sırasında gömülür)
PUBLIC_API_URL=https://api.devatlas.example.com

APP_URL=https://devatlas.example.com
CORS_ORIGIN=https://devatlas.example.com

# Veritabanı ve kimlik doğrulama (uzun, rastgele değerler kullanın)
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-at-least-32-random-characters-long

# E-posta (SMTP bilgileri sağlayıcıdan alınır)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=DevAtlas <no-reply@devatlas.example.com>

# İsteğe bağlı
SWAGGER_ENABLED=false
RUN_DB_SEED_ON_STARTUP=false
