FROM node:22-alpine

WORKDIR /app

# NEXT_PUBLIC_* değerleri derleme sırasında istemci paketine gömülür; bu yüzden build-time argüman.
ARG NEXT_PUBLIC_API_URL=http://localhost:3500
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
